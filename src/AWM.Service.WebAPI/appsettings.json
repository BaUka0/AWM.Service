{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "AWM.Service": "Debug"
        }
    },
    "AllowedHosts": "*",
    "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:3001",
        "http://localhost:3002",
        "http://localhost:3003",
        "http://localhost:3004",
        "http://localhost:5173"
    ],
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost;Database=awm_database;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
    },
    "JwtSettings": {
        "Issuer": "AWM.Service",
        "Audience": "AWM.Service",
        "Secret": "ThisShouldBeReplacedInProductionWithSomethingVerySecure!",
        "ExpirationMinutes": 1440,
        "RefreshTokenExpirationDays": 7
    },
    "DatabaseSettings": {
        "MigrateAtStartup": true
    },
    "FileStorage": {
        "Provider": "Local",
        "LocalBasePath": "uploads",
        "MaxAttachmentSizeMb": 50,
        "MaxReviewSizeMb": 10,
        "S3": {
            "BucketName": "awm-attachments",
            "Region": "us-east-1",
            "KeyPrefix": "attachments/",
            "ServiceUrl": "",
            "AccessKey": "",
            "SecretKey": "",
            "ForcePathStyle": false
        }
    },
    "Observability": {
        "EnableEfCommandLogging": false
    }
}
